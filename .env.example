# Default database is NASA/gravityguard.db. Environment variables must be exported.
# DATABASE_URL=sqlite:////absolute/path/to/gravityguard.db
SEED_DEMO=true
DEMO_PASSWORD=demo-orbit-2026
# No LLM API key is required. Deterministic explanations run onboard.
# Optional, explicit remote AI evidence selection. Not needed for the demo.
ENABLE_LLM=false
# Set MODEL_API_KEY only in your backend process environment.
# Do not put the key in this file or use a VITE_ variable.
# Provider: https://api.meta.ai/v1 ; model: muse-wonder-1.0
# SYNC_ENCRYPTION_KEY=<Fernet key; generated into .local/sync.key if omitted>
